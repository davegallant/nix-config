{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "defaultMode": "auto",
    "allow": [
      "Bash(curl*)",
      "Bash(darwin-rebuild *)",
      "Bash(gh api repos/*)",
      "Bash(gh auth status*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr list*)",
      "Bash(gh pr review*)",
      "Bash(gh pr view*)",
      "Bash(gh repo view*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh search *)",
      "Bash(git *)",
      "Bash(hunk session *)",
      "Bash(just*)",
      "Bash(kubectl api-resources*)",
      "Bash(kubectl api-versions*)",
      "Bash(kubectl cluster-info*)",
      "Bash(kubectl config current-context*)",
      "Bash(kubectl config get-contexts*)",
      "Bash(kubectl config view*)",
      "Bash(kubectl describe*)",
      "Bash(kubectl explain*)",
      "Bash(kubectl get*)",
      "Bash(kubectl logs*)",
      "Bash(kubectl top*)",
      "Bash(kubectl version*)",
      "Bash(ls*)",
      "Bash(make*)",
      "Bash(nix build*)",
      "Bash(nix eval*)",
      "Bash(nix flake*)",
      "Bash(nix fmt*)",
      "Bash(nix search*)",
      "Bash(nixfmt*)",
      "Bash(nixos-rebuild *)",
      "Bash(nvd diff*)",
      "Bash(sudo darwin-rebuild *)",
      "Bash(sudo nixos-rebuild *)",
      "Read(//private/tmp/claude/**)",
      "Read(//tmp/claude/**)",
      "Read(~/src/**)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(az * delete*)",
      "Bash(az * purge*)",
      "Bash(az * remove*)",
      "Bash(az * scale*)",
      "Bash(dd *)",
      "Bash(doas *)",
      "Bash(gh api * --method*DELETE*)",
      "Bash(gh api * --method*PATCH*)",
      "Bash(gh api * --method*PUT*)",
      "Bash(gh api * -X DELETE*)",
      "Bash(gh api * -X PATCH*)",
      "Bash(gh api * -X PUT*)",
      "Bash(gh api *dispatches*)",
      "Bash(gh api */git/*)",
      "Bash(gh api */merges*)",
      "Bash(gh pr close*)",
      "Bash(gh pr merge*)",
      "Bash(gh release *)",
      "Bash(gh repo delete*)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(git clean*)",
      "Bash(git -C * clean*)",
      "Bash(git push --force*)",
      "Bash(git -C * push --force*)",
      "Bash(git push -f*)",
      "Bash(git -C * push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git -C * reset --hard*)",
      "Bash(kill*)",
      "Bash(kubectl apply*)",
      "Bash(kubectl cordon*)",
      "Bash(kubectl create*)",
      "Bash(kubectl delete*)",
      "Bash(kubectl drain*)",
      "Bash(kubectl edit*)",
      "Bash(kubectl exec*)",
      "Bash(kubectl patch*)",
      "Bash(kubectl replace*)",
      "Bash(kubectl rollout restart*)",
      "Bash(kubectl run*)",
      "Bash(kubectl scale*)",
      "Bash(kubectl set*)",
      "Bash(kubectl taint*)",
      "Bash(mkfs*)",
      "Bash(nix store delete*)",
      "Bash(nix store wipe-cache*)",
      "Bash(pkill*)",
      "Bash(poweroff*)",
      "Bash(reboot*)",
      "Bash(rm -f*)",
      "Bash(rm -rf*)",
      "Bash(shutdown*)",
      "Bash(sudo -i*)",
      "Bash(sudo -s*)",
      "Bash(sudo bash*)",
      "Bash(sudo chmod*)",
      "Bash(sudo chown*)",
      "Bash(sudo dd *)",
      "Bash(sudo fish*)",
      "Bash(sudo mkfs*)",
      "Bash(sudo mv*)",
      "Bash(sudo nix store*)",
      "Bash(sudo nix-collect-garbage*)",
      "Bash(sudo poweroff*)",
      "Bash(sudo reboot*)",
      "Bash(sudo rm*)",
      "Bash(sudo sh*)",
      "Bash(sudo su*)",
      "Bash(sudo tee*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(.env.staging)",
      "Read(.env.test)",
      "Read(/etc/shadow)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/op/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.password-store/**)",
      "Read(~/.ssh/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.private.json)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "excludedCommands": [
      "darwin-rebuild",
      "hunk",
      "just",
      "nixos-rebuild"
    ],
    "enableWeakerNetworkIsolation": true,
    "filesystem": {
      "allowWrite": [
        "/tmp/",
        "/private/tmp/",
        "~/.cache/",
        "~/Library/Caches/",
        "~/.gnupg/",
        "~/.azure/",
        "~/.codex/",
        "~/.pi/",
        "~/.voicemode/",
        "~/.npm/",
        "~/go/",
        "~/.local/share/uv/",
        "~/src/github.com/",
        "~/Library/Application Support/UnityHub/logs/"
      ],
      "denyWrite": [
        "/etc",
        "/usr",
        "/nix/store",
        "~/.ssh",
        "~/.aws",
        "~/.config/gcloud",
        "~/.password-store",
        "~/.claude/settings.json",
        "~/.claude/settings.private.json"
      ],
      "denyRead": [
        "~/.aws/sso"
      ]
    },
    "network": {
      "allowAllUnixSockets": true,
      "allowedDomains": [
        "claude.com",
        "*.claude.com",
        "anthropic.com",
        "*.anthropic.com",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "cache.nixos.org",
        "channels.nixos.org",
        "*.nixos.org",
        "*.cachix.org",
        "pypi.org",
        "files.pythonhosted.org",
        "registry-1.docker.io",
        "*.docker.io",
        "ghcr.io",
        "127.0.0.1",
        "api.pagerduty.com",
        "us3.datadoghq.com",
        "*.googleapis.com",
        "registry.terraform.io",
        "releases.hashicorp.com",
        "registry.npmjs.org",
        "login.microsoftonline.com",
        "management.azure.com",
        "dc.services.visualstudio.com",
        "*.blob.core.windows.net",
        "ocsp.apple.com",
        "valid.apple.com",
        "ocsp.sectigo.com",
        "crt.sectigo.com"
      ]
    }
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "preferredNotifChannel": "ghostty",
  "editorMode": "vim",
  "effortLevel": "high",
  "model": "claude-opus-5-5",
  "outputStyle": "Concise"
}
